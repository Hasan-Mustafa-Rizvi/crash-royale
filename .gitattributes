# Text files are stored with LF line endings.
* text=auto eol=lf

# Unity's YAML assets merge better when Git treats them as text.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.cs text eol=lf diff=csharp

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.apk binary
